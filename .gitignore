# your own key and settings - never commit
.env
config.json

# work folders made by the tool
jobs/
logs/
setup_check.log

# AWS/local worker scratch
cloud_jobs/

# FFmpeg binaries you may put next to RUN.bat
ffmpeg/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv*/

# Terraform - the state file contains ARNs and must never be committed
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
